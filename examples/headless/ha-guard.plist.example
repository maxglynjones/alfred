<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.alfred.ha-guard</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>REPLACE_WITH_ABSOLUTE_SCRIPT_PATH</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>ALFRED_HA_VM_ID</key><string>REPLACE_WITH_UTM_UUID</string>
    <key>ALFRED_HA_URL</key><string>http://REPLACE_WITH_HA_ADDRESS:8123</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
</dict></plist>
